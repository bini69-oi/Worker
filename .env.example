# Скопируйте в .env и выполните chmod 600 .env
# Здесь только секреты и адреса. Всё остальное настраивается в админке.

# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID. Владелец задаётся только здесь
OWNER_TG_ID=
# Адрес, по которому бот доступен снаружи, только https
PUBLIC_URL=https://bot.example.com
# Панель Remnawave и её API-токен
PANEL_URL=https://panel.example.com
PANEL_TOKEN=
# Мастер-ключ шифрования секретов: openssl rand -base64 32
SECRET_KEY=
# Файл базы, по умолчанию worker.db
DB_PATH=worker.db
# Свой сервер Bot API, если он есть. Пусто: api.telegram.org
TELEGRAM_API_URL=
